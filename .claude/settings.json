{
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "hooks": {
        "PostToolUse": [
            {
                "matcher": "Edit|Write",
                "hooks": [
                    {
                        "type": "command",
                        "command": "node .claude/hooks/eslint-check.js"
                    }
                ]
            }
        ]
    },
    "permissions": {
        "deny": [
            "Read(./llm-ui/dist/**)",
            "Read(./llm-ui/node_modules/**)"
        ]
    }
}