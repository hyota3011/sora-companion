{
  "manifest_version": 3,
  "name": "Sora",
  "version": "1.0",
  "description": "A premium AI companion in your browser. Experience seamless chat streaming and intelligent assistance directly through your Chrome side panel.",
  "permissions": [
    "sidePanel",
    "storage",
    "tabs",
    "scripting"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open Sora"
  },
  "icons": {
    "16": "images/sora-16.png",
    "32": "images/sora-32.png",
    "64": "images/sora-64.png",
    "128": "images/sora-128.png"
  },
  "side_panel": {
    "default_path": "llm-ui/dist/index.html"
  },
    "host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}